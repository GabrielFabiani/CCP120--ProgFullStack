<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../CSS/estilo.css">
    <title>Status do login ou cadastro</title>
</head>
<body>
    <div class="card">
        <div class="titulo">
            <h1 class="<%= status.includes('Sucesso') ? 'success' : 'failure' %>">
                <%= status %>
            </h1>
            <p><%= mensagem %></p>
            <p>Coisas boas estão por vir! Aguarde</p>
        </div>
         <p>
            <a href="/">Projetos (Home)</a> |
            <a href="/login">Página de Login</a> |
            <a href="/cadastra">Página de Cadastro</a>
        </p>
    </div>
   
   
</body>
</html>